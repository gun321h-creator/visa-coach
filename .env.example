# Copy to .env and fill in. Never commit .env (it is gitignored).
# On Vercel, set these in Project Settings → Environment Variables instead.

# REQUIRED — AssemblyAI API key. Used server-side only, in api/token.js and
# api/report.js. The browser never sees it: /api/token mints a short-lived
# Voice Agent token instead. Get one at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_key_here

# OPTIONAL — model used for the end-of-session report via the AssemblyAI
# LLM Gateway (https://llm-gateway.assemblyai.com/v1/chat/completions).
# Leave unset and the app tries "claude-sonnet-5" first.
# NOTE: on the AssemblyAI free tier the gateway may only grant access to a
# small model, so api/report.js automatically falls back to
# "qwen3.5-4b-32k-fast" if the preferred model is refused. Set this only if
# you want to pin a specific model.
# REPORT_MODEL=claude-sonnet-5
